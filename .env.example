# Backblaze Native API credentials. Copy to .env and fill locally.
# Never use a master application key as an S3/AWS credential.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_API_MODE=native
B2_AUTH_URL=https://api.backblazeb2.com/b2api/v4/b2_authorize_account
B2_BUCKET_NAME=speakai2026
B2_BUCKET_ID=e5cc71977ef1880ca60b0c17

# Planned external-data layout; these values are not yet enforced by a worker.
B2_EXTERNAL_PREFIX=intelligentai/external
B2_DERIVED_PREFIX=intelligentai/derived
B2_COACHING_RELEASE_PREFIX=intelligentai/releases/coaching
RUNPOD_EXTERNAL_CACHE_DIR=/tmp/intelligentai-external-data
RUNPOD_EXTERNAL_CACHE_MAX_BYTES=4294967296
