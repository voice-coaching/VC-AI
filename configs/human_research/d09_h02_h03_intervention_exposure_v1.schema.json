{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-coach.local/schemas/d09_h02_h03_intervention_exposure_v1.schema.json",
  "title": "D09 H02-H03 restricted intervention exposure record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exposure_record_id_sha256",
    "participant_key_sha256",
    "session_id_sha256",
    "phase",
    "assigned_condition",
    "manual_version_id",
    "manual_sha256",
    "s108_completion_sha256",
    "e01_completion_sha256",
    "c02_completion_sha256",
    "e02_completion_sha256",
    "c03_completion_sha256",
    "e00_completion_sha256",
    "r03_bank_sha256",
    "r04_completion_sha256",
    "assigned_seconds",
    "received_seconds",
    "assigned_item_count",
    "received_item_count",
    "adherence_fraction",
    "coaching_delivered",
    "reference_delivered",
    "blocked_safe_action_preserved",
    "protocol_deviation_retained",
    "free_generation_used",
    "privacy_zone"
  ],
  "properties": {
    "schema_version": {"const": "voice_coach.d09_h02_h03_intervention_exposure.v1"},
    "exposure_record_id_sha256": {"$ref": "#/$defs/sha256"},
    "participant_key_sha256": {"$ref": "#/$defs/sha256"},
    "session_id_sha256": {"$ref": "#/$defs/sha256"},
    "phase": {"enum": ["feasibility", "confirmatory"]},
    "assigned_condition": {"enum": ["C0", "C3", "C5"]},
    "manual_version_id": {"$ref": "#/$defs/safeId"},
    "manual_sha256": {"$ref": "#/$defs/sha256"},
    "s108_completion_sha256": {"$ref": "#/$defs/sha256"},
    "e01_completion_sha256": {"$ref": "#/$defs/sha256"},
    "c02_completion_sha256": {"$ref": "#/$defs/sha256"},
    "e02_completion_sha256": {"$ref": "#/$defs/sha256"},
    "c03_completion_sha256": {"$ref": "#/$defs/sha256"},
    "e00_completion_sha256": {"$ref": "#/$defs/sha256"},
    "r03_bank_sha256": {"$ref": "#/$defs/sha256"},
    "r04_completion_sha256": {"$ref": "#/$defs/sha256"},
    "assigned_seconds": {"type": "integer", "minimum": 0},
    "received_seconds": {"type": "integer", "minimum": 0},
    "assigned_item_count": {"type": "integer", "minimum": 0},
    "received_item_count": {"type": "integer", "minimum": 0},
    "adherence_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "coaching_delivered": {"type": "boolean"},
    "reference_delivered": {"type": "boolean"},
    "blocked_safe_action_preserved": {"const": true},
    "protocol_deviation_retained": {"const": true},
    "free_generation_used": {"const": false},
    "privacy_zone": {"const": "D1_pseudonymized_restricted_human_research"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"}
  }
}
