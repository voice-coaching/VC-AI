        "deep_validation_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "decision": {"const": "passed"},
        "production_release_allowed": {"const": true}
      }
    },
    "e00": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_sha256",
        "contract_sha256",
        "completion_sha256",
        "reference_handoff_sha256",
        "d08_rights_lineage_sha256",
        "deep_validation_receipt_sha256",
