        "c5_uses_validated_s108_e01_c02_e02_c03_e00_r03_r04": {"const": true},
        "e00_d08_rights_lineage_bound": {"const": true},
        "locked_result_copy_or_replay_used": {"const": false},
        "free_generation_used": {"const": false},
        "human_effect_or_outcome_used_for_predecessor_selection": {"const": false},
        "participant_rows_present": {"const": false},
        "audio_or_rating_rows_present": {"const": false},
        "aggregate_only": {"const": true}
