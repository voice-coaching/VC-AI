{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice_coach.d08_recording_metadata_manifest.v1",
  "title": "D08 restricted recording metadata manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "r00_card_sha256",
    "h00_approval_sha256",
    "individual_consent_attestation_sha256",
    "recording_rights_attestation_sha256",
    "qc_preregistration_sha256",
    "privacy_zone",
    "publication_allowed",
    "contains_direct_identifiers",
    "contains_free_text",
    "rows"
  ],
  "properties": {
    "schema_version": {
      "const": "voice_coach.d08_recording_metadata_manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^d08m_[0-9a-f]{32}$"
    },
    "status": {
      "const": "recorded_pending_qc"
    },
    "r00_card_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "h00_approval_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "individual_consent_attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "recording_rights_attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "qc_preregistration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "privacy_zone": {
      "const": "R1_access_controlled_locator_metadata"
    },
    "publication_allowed": {
      "const": false
    },
    "contains_direct_identifiers": {
      "const": false
    },
    "contains_free_text": {
      "const": false
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/recordingRow"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "recordingRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recording_id",
        "speaker_id_sha256",
        "sentence_id",
        "target_text_sha256",
        "speaking_style",
        "take_index",
        "session_id_sha256",
        "equipment_profile_id_sha256",
        "microphone_profile_id_sha256",
        "room_profile_id_sha256",
        "r0_audio_locator_token_sha256",
        "audio_sha256",
        "sample_rate_hz",
        "bit_depth",
        "channel_count",
        "container_format",
        "codec",
        "mouth_to_microphone_distance_cm",
        "source_kind",
        "consent_receipt_sha256",
        "recording_license_grant_sha256",
        "native_korean_attested",
        "raw_audio_zone",
        "locator_manifest_zone",
        "publication_allowed"
      ],
      "properties": {
        "recording_id": {
          "type": "string",
          "pattern": "^d08r_[0-9a-f]{32}$"
        },
        "speaker_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sentence_id": {
          "type": "string",
          "pattern": "^R00-(0[1-9]|1[0-9]|20)$"
        },
        "target_text_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "speaking_style": {
          "enum": [
            "natural",
            "clear_educational"
          ]
        },
        "take_index": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "session_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "equipment_profile_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "microphone_profile_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "room_profile_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "r0_audio_locator_token_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "audio_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sample_rate_hz": {
          "const": 48000
        },
        "bit_depth": {
          "const": 24
        },
        "channel_count": {
          "const": 1
        },
        "container_format": {
          "const": "WAV"
        },
        "codec": {
          "const": "PCM"
        },
        "mouth_to_microphone_distance_cm": {
          "type": "number",
          "minimum": 15,
          "maximum": 20
        },
        "source_kind": {
          "const": "human_recording"
        },
        "consent_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "recording_license_grant_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_korean_attested": {
          "const": true
        },
        "raw_audio_zone": {
          "const": "R0_restricted_raw_audio"
        },
        "locator_manifest_zone": {
          "const": "R1_access_controlled_locator_metadata"
        },
        "publication_allowed": {
          "const": false
        }
      }
    }
  }
}
