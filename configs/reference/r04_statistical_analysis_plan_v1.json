    "exact_sample_size_formula_or_software": "monte_carlo_simulation_of_the_preregistered_cumulative_logit_mixed_model_1000_datasets_per_candidate_n_with_power_read_as_the_proportion_of_datasets_rejecting_at_alpha_0_05",
    "software_rationale_ko": "닫힌 형태 공식은 평정이 청자·문장에 중첩된 구조를 다루지 못한다. 분석에 쓸 모형 그대로 데이터를 생성해 검정력을 읽으면 설계와 분석이 같은 가정 위에 선다.",
    "pilot_variance_binding": "residual_and_random_effect_variances_taken_from_the_pilot_and_fixed_in_the_pilot_nuisance_attestation_before_the_confirmatory_run",
    "pilot_intra_listener_correlation_binding": "icc_1_from_the_pilot_listener_random_effect_fixed_in_the_same_attestation",
    "binding_rationale_ko": "분산을 본 실험 데이터에서 추정해 표본을 정하면 결과를 보고 설계를 고른 것이 된다. pilot에서 고정하고, pilot 참가자는 본 분석에서 제외한다.",
    "rater_population": "adult_native_korean_speakers_without_professional_speech_pathology_training",
    "rater_inclusion_and_exclusion": "include_self_reported_native_korean_from_birth_normal_hearing_headphone_listening_in_a_quiet_room_exclude_prior_exposure_to_this_project_or_its_audio_pilot_participation_or_failing_two_or_more_attention_checks",
    "rater_training_and_quality_control": "written_scale_definition_plus_six_anchor_items_before_the_session_with_no_correctness_feedback_and_attention_checks_embedded_at_a_rate_of_one_per_twenty_items",
    "attention_check_rationale_ko": "20항목당 1개는 청자가 눈치채지 않을 만큼 드물고 부주의를 잡아낼 만큼 잦다. 2회 이상 실패는 제외 기준이며, 이 규칙을 데이터를 보기 전에 고정한다.",
    "adjudication_policy": "no_adjudication_of_listener_ratings_disagreement_is_the_measurement"
  },
  "primary_analysis": {
    "model_family": "ordinal_mixed_effects",
    "listener_random_effect_required": true,
    "sentence_random_effect_required": true,
    "exact_estimand": "difference_in_latent_mean_naturalness_between_reference_conditions_on_the_ordinal_scale_marginalised_over_listeners_and_sentences",
    "ordinal_link_function": "cumulative_logit",
    "fixed_effects_formula": "rating ~ condition + block_index",
    "fixed_effects_rationale_ko": "condition이 관심 항이고, block_index는 피로 효과를 흡수한다. 청자 인구통계는 넣지 않는다 — 사전등록하지 않은 공변량을 넣으면 모형 선택의 자유도가 생긴다.",
    "random_effects_structure": "(1 | listener) + (1 | sentence) + (1 | listener:sentence)",
    "random_effects_rationale_ko": "같은 청자의 평정과 같은 문장에 대한 평정은 각각 상관된다. 두 무선효과만 넣으면 '이 청자가 이 문장을 어떻게 듣는가'라는 교호가 잔차로 흘러 구간이 좁아지므로 교호항을 함께 둔다.",
    "confidence_interval_definition": "profile_likelihood_interval_at_95_percent",
    "missing_data_policy": "missing_at_random_assumed_handled_by_the_model_without_imputation_with_missing_counts_reported_per_condition_and_per_listener",
    "model_convergence_policy": "on_non_convergence_simplify_the_random_effects_in_the_preregistered_order_listener_sentence_interaction_first_then_sentence_and_report_every_simplification_applied_never_switch_model_family",
    "convergence_rationale_ko": "수렴 실패 시 무엇을 어떤 순서로 줄일지 미리 정해두지 않으면, 결과가 나오는 조합을 찾을 때까지 바꾸게 된다. 순서를 고정하고 적용한 단순화를 전부 보고한다. 모형 계열 자체는 바꾸지 않는다 — 바꾸면 추정량이 달라진다."
  },
