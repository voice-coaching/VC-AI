{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice_coach.e01_metamorphic_report.v1",
  "title": "E01 aggregate-only metamorphic robustness report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "status",
    "privacy_zone",
    "contains_row_level_data",
    "contains_direct_or_pseudonymous_ids",
    "contains_free_text",
    "locked_test_access_count",
    "s203_expert_holdout_access_count",
    "config_sha256",
    "s108_commit_sha256",
    "selected_model_identity_sha256",
    "selected_checkpoint_sha256",
    "preregistration_sha256",
    "input_manifest_sha256",
    "metric_computation_external_to_static_package",
    "perturbation_results",
    "overall",
    "publication_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "voice_coach.e01_metamorphic_report.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^e01r_[0-9a-f]{32}$"
    },
    "status": {
      "const": "completed"
    },
    "privacy_zone": {
      "const": "A1_aggregate_only"
    },
    "contains_row_level_data": {
      "const": false
    },
    "contains_direct_or_pseudonymous_ids": {
      "const": false
    },
    "contains_free_text": {
      "const": false
    },
    "locked_test_access_count": {
      "const": 0
    },
    "s203_expert_holdout_access_count": {
      "const": 0
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "s108_commit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selected_model_identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "selected_checkpoint_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "preregistration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "input_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "metric_computation_external_to_static_package": {
      "const": true
    },
    "perturbation_results": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/perturbationResult"
      }
    },
    "overall": {
      "$ref": "#/$defs/overallResult"
    },
    "publication_allowed": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "perturbationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "perturbation_id",
        "expectation_type",
        "case_count",
        "evaluable_count",
        "passed_count",
        "failed_count",
        "invalid_count",
        "pass_rate",
        "confidence_interval_lower",
        "confidence_interval_upper",
        "decision"
      ],
      "properties": {
        "perturbation_id": {
          "enum": [
            "silence",
            "gain",
            "duration",
            "f0",
            "phone"
          ]
        },
        "expectation_type": {
          "enum": [
            "invariant",
            "monotonic_nonincreasing",
            "monotonic_nondecreasing",
            "targeted_change"
          ]
        },
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "evaluable_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "pass_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_interval_lower": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_interval_upper": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "decision": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        }
      }
    },
    "overallResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_count",
        "evaluable_count",
        "passed_count",
        "failed_count",
        "invalid_count",
        "metric",
        "operator",
        "threshold",
        "pass_rate",
        "gate_statistic_value",
        "decision"
      ],
      "properties": {
        "case_count": {
          "type": "integer",
          "minimum": 0
        },
        "evaluable_count": {
          "type": "integer",
          "minimum": 0
        },
        "passed_count": {
          "type": "integer",
          "minimum": 0
        },
        "failed_count": {
          "type": "integer",
          "minimum": 0
        },
        "invalid_count": {
          "type": "integer",
          "minimum": 0
        },
        "metric": {
          "const": "metamorphic_expectation_pass_rate"
        },
        "operator": {
          "const": "greater_than_or_equal"
        },
        "threshold": {
          "const": 0.95
        },
        "pass_rate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "gate_statistic_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "decision": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        }
      }
    }
  }
}
