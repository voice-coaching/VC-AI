{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-coach.local/schemas/d07_expert_rating_manifest_v1.schema.json",
  "title": "D07 independent expert original and adjudication ratings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "split",
    "item_manifest_sha256",
    "reviewer_attestation_sha256",
    "preregistration_sha256",
    "rubric_sha256",
    "primary_definition_sha256",
    "privacy_zone",
    "original_ratings_preserved",
    "rating_count",
    "ratings"
  ],
  "properties": {
    "schema_version": {
      "const": "voice_coach.d07_expert_rating_manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^d07ratings_[0-9a-f]{32}$"
    },
    "split": {
      "enum": [
        "calibration",
        "locked_test"
      ]
    },
    "item_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "reviewer_attestation_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "preregistration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "rubric_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "primary_definition_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "privacy_zone": {
      "const": "D1_pseudonymized_restricted_experiment"
    },
    "original_ratings_preserved": {
      "const": true
    },
    "rating_count": {
      "type": "integer",
      "minimum": 1
    },
    "ratings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rating"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$"
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rating_id",
        "item_id_sha256",
        "reviewer_id_sha256",
        "reviewer_role",
        "target_phone_index",
        "phone_realization",
        "error_type",
        "boundary_acceptable",
        "pronunciation_score",
        "comprehensibility_score",
        "fluency_score",
        "confidence",
        "original_rating_ids_sha256",
        "disagreement_receipt_sha256",
        "adjudication_reason_code",
        "adjudication_note",
        "independent_original_rating",
        "peer_rating_seen",
        "model_output_seen",
        "system_condition_seen",
        "rating_receipt_sha256"
      ],
      "properties": {
        "rating_id": {
          "type": "string",
          "pattern": "^d07rating_[0-9a-f]{32}$"
        },
        "item_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewer_role": {
          "enum": [
            "primary_reviewer_1",
            "primary_reviewer_2",
            "adjudicator"
          ]
        },
        "target_phone_index": {
          "type": "integer",
          "minimum": 0
        },
        "phone_realization": {
          "enum": [
            "correct",
            "substitution",
            "deletion",
            "uncertain"
          ]
        },
        "error_type": {
          "enum": [
            "initial_consonant",
            "final_consonant",
            "vowel_error",
            "tensification",
            "other",
            "repetition",
            "nasalization",
            "aspiration",
            "liquidization",
            "liaison_rule",
            "boundary_intonation_error",
            "n_insertion",
            "palatalization",
            "stress_error",
            "interjection",
            "vowel_insertion",
            "phoneme_deletion",
            "uncertain"
          ]
        },
        "boundary_acceptable": {
          "enum": [
            "yes",
            "no",
            "uncertain"
          ]
        },
        "pronunciation_score": {
          "$ref": "#/$defs/score"
        },
        "comprehensibility_score": {
          "$ref": "#/$defs/score"
        },
        "fluency_score": {
          "$ref": "#/$defs/score"
        },
        "confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "original_rating_ids_sha256": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "disagreement_receipt_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "adjudication_reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/safeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "adjudication_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "independent_original_rating": {
          "type": "boolean"
        },
        "peer_rating_seen": {
          "type": "boolean"
        },
        "model_output_seen": {
          "const": false
        },
        "system_condition_seen": {
          "const": false
        },
        "rating_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    }
  }
}
