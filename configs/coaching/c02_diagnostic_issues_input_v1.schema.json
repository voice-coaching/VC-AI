{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-coach.local/schemas/c02_diagnostic_issues_input_v1.schema.json",
  "title": "C02 calibrated diagnostic issues input",
  "description": "D1 pseudonymized issue input for deterministic ontology-only coaching selection. Raw audio/text, paths, direct identifiers, prompts, completions, and generated prose are prohibited.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_id",
    "request_id_sha256",
    "c01_validation_report_sha256",
    "s107_completion_commit_sha256",
    "s107_threshold_policy_report_sha256",
    "c02_preregistration_sha256",
    "top_k",
    "confidence_threshold",
    "confidence_semantics",
    "privacy_zone",
    "issues"
  ],
  "properties": {
    "schema_version": {
      "const": "voice_coach.c02_diagnostic_issues_input.v1"
    },
    "input_id": {
      "type": "string",
      "pattern": "^c02in_[0-9a-f]{32}$"
    },
    "request_id_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "c01_validation_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "s107_completion_commit_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "s107_threshold_policy_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "c02_preregistration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "top_k": {
      "enum": [
        1,
        3
      ]
    },
    "confidence_threshold": {
      "$ref": "#/$defs/probability"
    },
    "confidence_semantics": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9_]+$"
    },
    "privacy_zone": {
      "const": "D1_pseudonymized_restricted_experiment"
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "nullablePhone": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 16
    },
    "evidenceId": {
      "enum": [
        "gold_label",
        "ctc_competing_phone",
        "gop_low",
        "duration_short",
        "duration_long",
        "alignment_low",
        "content_mismatch",
        "prosody_outlier"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_id_sha256",
        "issue_type",
        "start_ms",
        "end_ms",
        "target",
        "observed",
        "severity",
        "calibrated_confidence",
        "comprehensibility_impact",
        "trainability",
        "evidence_ids",
        "s107_calibration_row_sha256",
        "claim_evidence_sha256",
        "target_overlap_evidence_sha256"
      ],
      "properties": {
        "issue_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "issue_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "start_ms": {
          "type": "integer",
          "minimum": 0
        },
        "end_ms": {
          "type": "integer",
          "minimum": 1
        },
        "target": {
          "$ref": "#/$defs/nullablePhone"
        },
        "observed": {
          "$ref": "#/$defs/nullablePhone"
        },
        "severity": {
          "$ref": "#/$defs/probability"
        },
        "calibrated_confidence": {
          "$ref": "#/$defs/probability"
        },
        "comprehensibility_impact": {
          "$ref": "#/$defs/probability"
        },
        "trainability": {
          "$ref": "#/$defs/probability"
        },
        "evidence_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/evidenceId"
          }
        },
        "s107_calibration_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "claim_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "target_overlap_evidence_sha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
