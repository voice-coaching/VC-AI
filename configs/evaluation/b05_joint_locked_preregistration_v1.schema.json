{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-coach.local/schemas/b05_joint_locked_preregistration_v1.schema.json",
  "title": "B05 and S108 joint one-shot locked evaluation preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "preregistration_id",
    "status",
    "frozen_before_any_locked_access",
    "predecessor_bindings",
    "b03_canonical_baseline",
    "s108_arm",
    "joint_batch",
    "analysis_plan",
    "approvals",
    "privacy_and_claims",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "voice_coach.b05_joint_locked_preregistration.v1"
    },
    "preregistration_id": {
      "type": "string",
      "pattern": "^b05prereg_[0-9a-f]{32}$"
    },
    "status": {
      "const": "approved_and_frozen"
    },
    "frozen_before_any_locked_access": {
      "const": true
    },
    "predecessor_bindings": {
      "$ref": "#/$defs/predecessorBindings"
    },
    "b03_canonical_baseline": {
      "$ref": "#/$defs/b03Baseline"
    },
    "s108_arm": {
      "$ref": "#/$defs/s108Arm"
    },
    "joint_batch": {
      "$ref": "#/$defs/jointBatch"
    },
    "analysis_plan": {
      "$ref": "#/$defs/analysisPlan"
    },
    "approvals": {
      "$ref": "#/$defs/approvals"
    },
    "privacy_and_claims": {
      "$ref": "#/$defs/privacyAndClaims"
    },
    "binding_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "predecessorBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "b03_config_sha256",
        "b03_report_sha256",
        "b03_registry_sha256",
        "b03_checkpoint_set_sha256",
        "g04_completion_sha256",
        "d07_completion_sha256",
        "s107_commit_sha256",
        "s108_arm_freeze_sha256"
      ],
      "properties": {
        "b03_config_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "b03_report_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "b03_registry_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "b03_checkpoint_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "g04_completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "d07_completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "s107_commit_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "s108_arm_freeze_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "b03Baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seeds",
        "checkpoint_set_sha256",
        "feature_allowlist_sha256",
        "phone_decision_threshold",
        "threshold_origin",
        "seed_ensemble_definition",
        "posthoc_b06_substitution_used",
        "result_based_change_allowed"
      ],
      "properties": {
        "seeds": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              42,
              43,
              44
            ]
          }
        },
        "checkpoint_set_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "feature_allowlist_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "phone_decision_threshold": {
          "const": 0.5
        },
        "threshold_origin": {
          "const": "b03_sklearn_predict_default_not_b06_posthoc"
        },
        "seed_ensemble_definition": {
          "const": "no_prediction_ensemble_independent_seed_metrics_then_arithmetic_mean"
        },
        "posthoc_b06_substitution_used": {
          "const": false
        },
        "result_based_change_allowed": {
          "const": false
        }
      }
    },
    "s108Arm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_freeze_sha256",
        "model_identity_sha256",
        "checkpoint_sha256",
        "calibrator_sha256",
        "threshold_policy_sha256",
        "execution_spec_sha256",
        "result_based_change_allowed"
      ],
      "properties": {
        "arm_freeze_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_identity_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "calibrator_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "threshold_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "execution_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "result_based_change_allowed": {
          "const": false
        }
      }
    },
    "jointBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "included_arms",
        "same_locked_batch_manifest_required",
        "both_arms_immutable_before_access",
        "first_arm_result_hidden_until_both_arms_sealed",
        "authorized_locked_access_count",
        "rerun_after_success_allowed",
        "rerun_after_failure_allowed",
        "new_independent_test_set_required_for_any_new_run",
        "joint_atomic_publication_required"
      ],
      "properties": {
        "included_arms": {
          "const": [
            "b05_explicit_baseline",
            "s108_final_s1"
          ]
        },
        "same_locked_batch_manifest_required": {
          "const": true
        },
        "both_arms_immutable_before_access": {
          "const": true
        },
        "first_arm_result_hidden_until_both_arms_sealed": {
          "const": true
        },
        "authorized_locked_access_count": {
          "const": 1
        },
        "rerun_after_success_allowed": {
          "const": false
        },
        "rerun_after_failure_allowed": {
          "const": false
        },
        "new_independent_test_set_required_for_any_new_run": {
          "const": true
        },
        "joint_atomic_publication_required": {
          "const": true
        }
      }
    },
    "analysisPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked_population_definition_sha256",
        "phone_confusion_definition_sha256",
        "utterance_ordinal_confusion_definition_sha256",
        "slice_family_definition_sha256",
        "slice_axes",
        "speaker_cluster_bootstrap_method",
        "bootstrap_repetitions",
        "confidence_level",
        "multiple_comparison_correction",
        "holm_family_definition_sha256",
        "missing_data_policy_sha256",
        "undefined_metric_policy_sha256",
        "minimum_support_policy_sha256",
        "minimum_support_thresholds",
        "primary_estimands_sha256",
        "slice_result_keys",
        "bootstrap_result_keys",
        "holm_hypotheses",
        "cluster_unit"
      ],
      "properties": {
        "locked_population_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "phone_confusion_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "utterance_ordinal_confusion_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "slice_family_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "slice_axes": {
          "const": [
            "l1",
            "gender",
            "proficiency",
            "duration_bucket",
            "target_phone",
            "error_tag"
          ]
        },
        "speaker_cluster_bootstrap_method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9_.-]+$"
        },
        "bootstrap_repetitions": {
          "const": 5000
        },
        "confidence_level": {
          "const": 0.95
        },
        "multiple_comparison_correction": {
          "const": "holm"
        },
        "holm_family_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "missing_data_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "undefined_metric_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "minimum_support_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "minimum_support_thresholds": {
          "$ref": "#/$defs/minimumSupportThresholds"
        },
        "primary_estimands_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "slice_result_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sliceResultKey"
          }
        },
        "bootstrap_result_keys": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/bootstrapResultKey"
          }
        },
        "holm_hypotheses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/holmHypothesis"
          }
        },
        "cluster_unit": {
          "const": "speaker_id_sha256"
        }
      }
    },
    "minimumSupportThresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone_positive_count",
        "phone_negative_count",
        "utterance_row_count",
        "slice_speaker_count",
        "slice_row_count"
      ],
      "properties": {
        "phone_positive_count": {
          "type": "integer",
          "minimum": 1
        },
        "phone_negative_count": {
          "type": "integer",
          "minimum": 1
        },
        "utterance_row_count": {
          "type": "integer",
          "minimum": 1
        },
        "slice_speaker_count": {
          "type": "integer",
          "minimum": 1
        },
        "slice_row_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sliceResultKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "group_token_sha256",
        "unit",
        "metric_name",
        "missing_allowed"
      ],
      "properties": {
        "axis": {
          "enum": [
            "l1",
            "gender",
            "proficiency",
            "duration_bucket",
            "target_phone",
            "error_tag"
          ]
        },
        "group_token_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unit": {
          "enum": [
            "phone",
            "utterance"
          ]
        },
        "metric_name": {
          "enum": [
            "macro_f1",
            "auprc",
            "qwk",
            "spearman",
            "mae",
            "icc_2_1"
          ]
        },
        "missing_allowed": {
          "type": "boolean"
        }
      }
    },
    "bootstrapResultKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimand_id_sha256",
        "metric_name"
      ],
      "properties": {
        "estimand_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metric_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_.-]+$"
        }
      }
    },
    "holmHypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id_sha256",
        "hypothesis_id_sha256",
        "family_size",
        "alpha"
      ],
      "properties": {
        "family_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "hypothesis_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "family_size": {
          "type": "integer",
          "minimum": 1
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_owner_approved",
        "statistics_owner_approved",
        "privacy_owner_approved",
        "signed_protocol_receipt_sha256",
        "signed_statistics_receipt_sha256",
        "signed_privacy_receipt_sha256"
      ],
      "properties": {
        "protocol_owner_approved": {
          "const": true
        },
        "statistics_owner_approved": {
          "const": true
        },
        "privacy_owner_approved": {
          "const": true
        },
        "signed_protocol_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signed_statistics_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "signed_privacy_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "privacyAndClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_identifiers",
        "contains_rows",
        "contains_audio",
        "contains_labels",
        "contains_predictions",
        "contains_locked_results",
        "b05_completion_claim_allowed_before_joint_receipt",
        "s108_completion_claim_allowed_before_joint_receipt",
        "deployment_claim_allowed"
      ],
      "properties": {
        "contains_identifiers": {
          "const": false
        },
        "contains_rows": {
          "const": false
        },
        "contains_audio": {
          "const": false
        },
        "contains_labels": {
          "const": false
        },
        "contains_predictions": {
          "const": false
        },
        "contains_locked_results": {
          "const": false
        },
        "b05_completion_claim_allowed_before_joint_receipt": {
          "const": false
        },
        "s108_completion_claim_allowed_before_joint_receipt": {
          "const": false
        },
        "deployment_claim_allowed": {
          "const": false
        }
      }
    }
  }
}
