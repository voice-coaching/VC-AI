{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voice-coach.local/schemas/b05_locked_aggregate_report_v1.schema.json",
  "title": "A1 aggregate B05 one-shot locked evaluation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "status",
    "config_sha256",
    "preregistration_sha256",
    "batch_manifest_sha256",
    "authorization_sha256",
    "one_shot_transaction_id_sha256",
    "b03_config_sha256",
    "b03_report_sha256",
    "b03_registry_sha256",
    "b03_checkpoint_set_sha256",
    "b03_feature_allowlist_sha256",
    "s108_arm_freeze_sha256",
    "locked_predictions_sha256",
    "locked_utterance_count",
    "locked_phone_count",
    "seeds",
    "phone_seed_results",
    "utterance_seed_results",
    "slice_results",
    "speaker_cluster_bootstrap_results",
    "holm_results",
    "analysis_policy_bindings",
    "one_shot_assurance",
    "privacy_and_claims",
    "binding_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "voice_coach.b05_locked_aggregate_report.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^b05report_[0-9a-f]{32}$"
    },
    "status": {
      "const": "completed_joint_one_shot_locked_evaluation"
    },
    "config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "preregistration_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "batch_manifest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "authorization_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "one_shot_transaction_id_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "b03_config_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "b03_report_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "b03_registry_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "b03_checkpoint_set_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "b03_feature_allowlist_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "s108_arm_freeze_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "locked_predictions_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "locked_utterance_count": {
      "type": "integer",
      "minimum": 1
    },
    "locked_phone_count": {
      "type": "integer",
      "minimum": 1
    },
    "seeds": {
      "const": [
        42,
        43,
        44
      ]
    },
    "phone_seed_results": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/phoneSeedResult"
      }
    },
    "utterance_seed_results": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "$ref": "#/$defs/utteranceSeedResult"
      }
    },
    "slice_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sliceResult"
      }
    },
    "speaker_cluster_bootstrap_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/bootstrapResult"
      }
    },
    "holm_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/holmResult"
      }
    },
    "analysis_policy_bindings": {
      "$ref": "#/$defs/analysisPolicyBindings"
    },
    "one_shot_assurance": {
      "$ref": "#/$defs/oneShotAssurance"
    },
    "privacy_and_claims": {
      "$ref": "#/$defs/privacyAndClaims"
    },
    "binding_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableFinite": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "phoneSeedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "true_negative_count",
        "false_positive_count",
        "false_negative_count",
        "true_positive_count",
        "negative_support",
        "positive_support",
        "metric_status",
        "macro_f1",
        "auprc"
      ],
      "properties": {
        "seed": {
          "enum": [
            42,
            43,
            44
          ]
        },
        "true_negative_count": {
          "type": "integer",
          "minimum": 0
        },
        "false_positive_count": {
          "type": "integer",
          "minimum": 0
        },
        "false_negative_count": {
          "type": "integer",
          "minimum": 0
        },
        "true_positive_count": {
          "type": "integer",
          "minimum": 0
        },
        "negative_support": {
          "type": "integer",
          "minimum": 0
        },
        "positive_support": {
          "type": "integer",
          "minimum": 0
        },
        "metric_status": {
          "enum": [
            "estimable",
            "undefined_per_preregistered_policy"
          ]
        },
        "macro_f1": {
          "$ref": "#/$defs/nullableFinite"
        },
        "auprc": {
          "$ref": "#/$defs/nullableFinite"
        }
      }
    },
    "matrixRow": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "ordinalMatrix": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/matrixRow"
      }
    },
    "utteranceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qwk",
        "spearman",
        "mae",
        "icc_2_1"
      ],
      "properties": {
        "qwk": {
          "$ref": "#/$defs/nullableFinite"
        },
        "spearman": {
          "$ref": "#/$defs/nullableFinite"
        },
        "mae": {
          "$ref": "#/$defs/nullableFinite"
        },
        "icc_2_1": {
          "$ref": "#/$defs/nullableFinite"
        }
      }
    },
    "utteranceSeedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "outcome",
        "support",
        "metric_status",
        "ordinal_confusion_matrix",
        "metrics"
      ],
      "properties": {
        "seed": {
          "enum": [
            42,
            43,
            44
          ]
        },
        "outcome": {
          "enum": [
            "pronunciation_score",
            "fluency_score",
            "comprehensibility_score"
          ]
        },
        "support": {
          "type": "integer",
          "minimum": 0
        },
        "metric_status": {
          "enum": [
            "estimable",
            "undefined_per_preregistered_policy"
          ]
        },
        "ordinal_confusion_matrix": {
          "$ref": "#/$defs/ordinalMatrix"
        },
        "metrics": {
          "$ref": "#/$defs/utteranceMetrics"
        }
      }
    },
    "sliceResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "group_token_sha256",
        "unit",
        "metric_name",
        "speaker_support",
        "row_support",
        "positive_support",
        "negative_support",
        "status",
        "estimate"
      ],
      "properties": {
        "axis": {
          "enum": [
            "l1",
            "gender",
            "proficiency",
            "duration_bucket",
            "target_phone",
            "error_tag"
          ]
        },
        "group_token_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unit": {
          "enum": [
            "phone",
            "utterance"
          ]
        },
        "metric_name": {
          "enum": [
            "macro_f1",
            "auprc",
            "qwk",
            "spearman",
            "mae",
            "icc_2_1"
          ]
        },
        "speaker_support": {
          "type": "integer",
          "minimum": 0
        },
        "row_support": {
          "type": "integer",
          "minimum": 0
        },
        "positive_support": {
          "type": "integer",
          "minimum": 0
        },
        "negative_support": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "estimable",
            "undefined_below_support",
            "missing_per_preregistered_policy"
          ]
        },
        "estimate": {
          "$ref": "#/$defs/nullableFinite"
        }
      }
    },
    "bootstrapResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "estimand_id_sha256",
        "metric_name",
        "cluster_unit",
        "method",
        "repetitions",
        "confidence_level",
        "status",
        "point_estimate",
        "confidence_interval_lower",
        "confidence_interval_upper"
      ],
      "properties": {
        "estimand_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "metric_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9_.-]+$"
        },
        "cluster_unit": {
          "const": "speaker_id_sha256"
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9_.-]+$"
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        },
        "confidence_level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "status": {
          "enum": [
            "estimable",
            "undefined_per_preregistered_policy"
          ]
        },
        "point_estimate": {
          "$ref": "#/$defs/nullableFinite"
        },
        "confidence_interval_lower": {
          "$ref": "#/$defs/nullableFinite"
        },
        "confidence_interval_upper": {
          "$ref": "#/$defs/nullableFinite"
        }
      }
    },
    "holmResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id_sha256",
        "hypothesis_id_sha256",
        "family_size",
        "status",
        "raw_p_value",
        "adjusted_p_value",
        "alpha",
        "rejected"
      ],
      "properties": {
        "family_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "hypothesis_id_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "family_size": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "estimable",
            "undefined_per_preregistered_policy"
          ]
        },
        "raw_p_value": {
          "$ref": "#/$defs/nullableFinite"
        },
        "adjusted_p_value": {
          "$ref": "#/$defs/nullableFinite"
        },
        "alpha": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "rejected": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "analysisPolicyBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "locked_population_definition_sha256",
        "phone_confusion_definition_sha256",
        "utterance_ordinal_confusion_definition_sha256",
        "slice_family_definition_sha256",
        "holm_family_definition_sha256",
        "missing_data_policy_sha256",
        "undefined_metric_policy_sha256",
        "minimum_support_policy_sha256",
        "primary_estimands_sha256"
      ],
      "properties": {
        "locked_population_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "phone_confusion_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "utterance_ordinal_confusion_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "slice_family_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "holm_family_definition_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "missing_data_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "undefined_metric_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "minimum_support_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "primary_estimands_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "oneShotAssurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "joint_locked_access_count",
        "b05_execution_count",
        "s108_execution_count",
        "both_arms_sealed_before_result_release",
        "first_arm_result_visible_before_second_arm_sealed",
        "arm_mutation_after_access",
        "rerun_count",
        "rerun_allowed",
        "new_independent_test_set_required_for_new_run"
      ],
      "properties": {
        "joint_locked_access_count": {
          "const": 1
        },
        "b05_execution_count": {
          "const": 1
        },
        "s108_execution_count": {
          "const": 1
        },
        "both_arms_sealed_before_result_release": {
          "const": true
        },
        "first_arm_result_visible_before_second_arm_sealed": {
          "const": false
        },
        "arm_mutation_after_access": {
          "const": false
        },
        "rerun_count": {
          "const": 0
        },
        "rerun_allowed": {
          "const": false
        },
        "new_independent_test_set_required_for_new_run": {
          "const": true
        }
      }
    },
    "privacyAndClaims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "privacy_zone",
        "contains_identifiers",
        "contains_rows",
        "contains_audio_or_locator",
        "contains_labels",
        "contains_predictions",
        "contains_free_text",
        "oracle_alignment_research_only",
        "deployment_claim_allowed",
        "b05_completion_claim_allowed"
      ],
      "properties": {
        "privacy_zone": {
          "const": "A1_aggregate_locked_evaluation"
        },
        "contains_identifiers": {
          "const": false
        },
        "contains_rows": {
          "const": false
        },
        "contains_audio_or_locator": {
          "const": false
        },
        "contains_labels": {
          "const": false
        },
        "contains_predictions": {
          "const": false
        },
        "contains_free_text": {
          "const": false
        },
        "oracle_alignment_research_only": {
          "const": true
        },
        "deployment_claim_allowed": {
          "const": false
        },
        "b05_completion_claim_allowed": {
          "const": false
        }
      }
    }
  }
}
