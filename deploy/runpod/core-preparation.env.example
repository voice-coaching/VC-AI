# No extra worker by default. Set BOTH values from measured startup peak/RSS.
# Reserve is additional standby peak; min-free preserves other service headroom.
# Unknown/unlimited cgroup accounting disables preparation of a second worker.
AI_CANONICAL_STANDBY_RESERVE_BYTES=0
AI_CANONICAL_STANDBY_MIN_FREE_BYTES=0
# Do not configure AI_CANONICAL_VERIFIED_GENERATION: supervisor-owned per job.
