{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["levels", "score", "feedback"],
  "additionalProperties": false,
  "properties": {
    "levels": {},
    "score": {},
    "feedback": {"type": "string", "minLength": 1, "maxLength": 4000}
  },
  "oneOf": [
    {
      "properties": {
        "levels": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "items": {"type": ["integer", "null"], "minimum": 0, "maximum": 4},
          "contains": {"type": "integer"}, "minContains": 1
        },
        "score": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    {
      "properties": {
        "levels": {"type": "null"},
        "score": {"type": "null"}
      }
    }
  ]
}
