# Default OFF; no anonymous endpoint is activated merely by copying code.
AI_DIRECT_ENABLED=false
AI_DIRECT_SPOOL_ROOT=/workspace/intelligentai/direct-spool
AI_DIRECT_ALLOWED_ORIGINS=https://vc-fe.vercel.app
AI_DIRECT_BIND_HOST=127.0.0.1
AI_DIRECT_PORT=8083
AI_DIRECT_HISTORY_BASE_URL=https://api.voice-coaching.site
AI_DIRECT_RECORDING_PREFIX=recordings/direct-analysis
# Supply approved Native core/H5 paths and existing NLTK path from reviewed release.
# AI_CANONICAL_CORE_ROOT, AI_CANONICAL_LLM_ROOT, AI_ANALYSIS_NLTK_DATA_ROOT
# Secrets come only from the operator-owned environment, never the FE bundle:
# OPENAI_API_KEY, AI_ANALYSIS_CALLBACK_TOKEN
# AI_CANONICAL_EVIDENCE_B2_* and AI_ANALYSIS_OBJECT_STORAGE_*
# Recording credentials require PUT/HEAD in the configured direct prefix.
