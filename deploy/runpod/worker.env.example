# Private /root/.config/intelligentai/analysis-worker.env; owner root, mode 0600.
# For container recreation, supply these literal values as a JSON object in
# RUNPOD_ANALYSIS_WORKER_ENV_JSON through RunPod's private environment settings.
# Never place this populated file in /workspace, Git, or recovery archives.
AI_ANALYSIS_REDIS_HOST=
AI_ANALYSIS_REDIS_PORT=6379
AI_ANALYSIS_REDIS_USERNAME=
AI_ANALYSIS_REDIS_PASSWORD=
AI_ANALYSIS_REDIS_CA_CERT=/etc/ssl/certs/ca-certificates.crt
AI_ANALYSIS_OBJECT_STORAGE_BUCKET=
AI_ANALYSIS_OBJECT_STORAGE_REGION=
AI_ANALYSIS_OBJECT_STORAGE_ENDPOINT=
AI_ANALYSIS_OBJECT_STORAGE_PATH_STYLE=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AI_ANALYSIS_AUTHORIZATION_KEYS_JSON=
AI_ANALYSIS_ACTIVE_AUTHORIZATION_KEY_ID=
AI_ANALYSIS_CONSENT_POLICY_REVISION=
# HMAC key IDs/secrets and policy must match VC-BE. Do not create new keys on boot.
# B2 Master Application Keys cannot be used as S3/AWS credentials.
