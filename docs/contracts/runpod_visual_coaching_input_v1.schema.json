{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-coaching.visual-coaching-input.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "voice-coaching.visual-coaching-input.v1"
      ]
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "coreSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "visualEvidenceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "status": {
      "enum": [
        "NOT_PROVIDED",
        "OBSERVED",
        "REFERENCE_ONLY",
        "SCORED",
        "UNSCORABLE",
        "FAILED",
        "TIMEOUT"
      ]
    },
    "correctiveClaimsAllowed": {
      "const": false
    },
    "score": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "scoreKind": {
      "enum": [
        "NONE",
        "CALIBRATED",
        "PROVISIONAL"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
      },
      "maxItems": 32
    },
    "selectionPolicy": {
      "enum": [
        "FIRST_12_OBSERVED_MFA_INDICES_V1",
        "LOWEST_12_SCORED_THEN_OBSERVED_V1"
      ]
    },
    "availablePhoneCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "omittedPhoneCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "phones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "expectedPhone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "role": {
            "enum": [
              "onset",
              "nucleus",
              "coda"
            ]
          },
          "status": {
            "enum": [
              "OBSERVED",
              "REFERENCE_ONLY",
              "SCORED",
              "UNSCORABLE"
            ]
          },
          "score": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "scoreKind": {
            "enum": [
              "NONE",
              "REFERENCE_SIMILARITY",
              "CALIBRATED",
              "PROVISIONAL"
            ]
          },
          "audioStartSeconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "audioEndSeconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 120
              },
              {
                "type": "null"
              }
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "observationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}:phone-[0-9]+:LIP_(APERTURE|WIDTH|AREA)_RANGE$"
                },
                "code": {
                  "enum": [
                    "LIP_APERTURE_RANGE",
                    "LIP_WIDTH_RANGE",
                    "LIP_AREA_RANGE"
                  ]
                },
                "minimum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "maximum": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "unit": {
                  "enum": [
                    "FACE_SCALE_NORMALIZED"
                  ]
                }
              },
              "required": [
                "observationId",
                "code",
                "minimum",
                "maximum",
                "unit"
              ]
            },
            "maxItems": 3
          },
          "allowedActionIds": {
            "type": "array",
            "items": {
              "enum": [
                "COMPARE_REFERENCE"
              ]
            },
            "maxItems": 1
          },
          "reasonCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,79}$"
            },
            "maxItems": 32
          },
          "subScores": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/lipSubScore"
            }
          }
        },
        "required": [
          "expectedIndex",
          "expectedPhone",
          "role",
          "status",
          "score",
          "scoreKind",
          "audioStartSeconds",
          "audioEndSeconds",
          "observations",
          "allowedActionIds",
          "reasonCodes"
        ]
      },
      "maxItems": 12
    },
    "comparisonPolicy": {
      "const": "PHONE_ROLE_PARTIAL_PROVISIONAL_V1"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "visuallyEligibleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "observedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "scoredCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2048
        },
        "coverage": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "targetCount",
        "visuallyEligibleCount",
        "observedCount",
        "scoredCount",
        "coverage"
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "maxLength": 240
      }
    },
    "partialScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "scoreKind",
        "scope"
      ],
      "properties": {
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "scoreKind": {
          "const": "PROVISIONAL"
        },
        "scope": {
          "const": "ASSESSED_PHONES_ONLY"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "executionId",
    "coreSha256",
    "visualEvidenceSha256",
    "status",
    "correctiveClaimsAllowed",
    "score",
    "scoreKind",
    "reasonCodes",
    "selectionPolicy",
    "availablePhoneCount",
    "omittedPhoneCount",
    "phones"
  ],
  "$defs": {
    "lipSubScore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "label",
        "score",
        "status",
        "reasonCode"
      ],
      "properties": {
        "criterionId": {
          "enum": [
            "lip_aperture",
            "lip_rounding",
            "lip_closure",
            "lip_timing"
          ]
        },
        "label": {
          "type": "string"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "enum": [
            "SCORED",
            "UNSCORABLE",
            "NOT_APPLICABLE"
          ]
        },
        "reasonCode": {
          "type": "string"
        },
        "measurements": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metricId",
              "value",
              "referenceMedian",
              "referenceScale",
              "referenceCount",
              "tolerance",
              "unit"
            ],
            "properties": {
              "metricId": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "referenceMedian": {
                "type": "number"
              },
              "referenceScale": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "referenceCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 32
              },
              "tolerance": {
                "type": "number",
                "minimum": 0
              },
              "unit": {
                "enum": [
                  "PHONE_PHASE",
                  "FACE_SCALE_NORMALIZED"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SCORED"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
