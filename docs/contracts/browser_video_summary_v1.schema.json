{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "voice-coaching.browser-video-summary.v1"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "executionId": {
      "type": "string",
      "format": "uuid"
    },
    "clientRequestId": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "COMPLETED",
        "FAILED"
      ]
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overallScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "validity": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/scoreDetails"
        }
      },
      "required": [
        "overallScore",
        "validity",
        "reason"
      ]
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "scoreKind": {
          "enum": [
            "NONE",
            "PROVISIONAL",
            "CALIBRATED"
          ]
        },
        "scoreScope": {
          "enum": [
            "UNAVAILABLE",
            "ASSESSED_PHONES_ONLY",
            "WHOLE_CLIP"
          ]
        }
      },
      "required": [
        "score",
        "scoreKind",
        "scoreScope"
      ]
    },
    "coaching": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "feedback": {
          "type": "string"
        }
      },
      "required": [
        "feedback"
      ]
    },
    "failure": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string"
            }
          },
          "required": [
            "code"
          ]
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "jobId",
    "executionId",
    "clientRequestId",
    "status",
    "score",
    "visual",
    "coaching",
    "failure"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "voice-coaching.browser-video-summary.v1",
  "$defs": {
    "scoreDetails": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "validationStatus",
        "aggregationMode",
        "audioScore",
        "visualScore",
        "audioWeight",
        "visualWeight",
        "criteria"
      ],
      "properties": {
        "schemaVersion": {
          "const": "voice-coaching.score-details.v1"
        },
        "validationStatus": {
          "const": "EXPERT_REVIEW_PENDING"
        },
        "aggregationMode": {
          "enum": [
            "AUDIO_ONLY",
            "AUDIO_VISUAL"
          ]
        },
        "audioScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "visualScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "audioWeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "visualWeight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "criteria": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/scoreDetailCriterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "pronunciation_accuracy"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/scoreDetailCriterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "speaking_rate"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/scoreDetailCriterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "articulation_rate"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/scoreDetailCriterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "pauses"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/scoreDetailCriterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "pitch"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/scoreDetailCriterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "intensity"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        }
      }
    },
    "scoreDetailCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "label",
        "score",
        "status",
        "reasonCode",
        "weight"
      ],
      "properties": {
        "criterionId": {
          "enum": [
            "pronunciation_accuracy",
            "speaking_rate",
            "articulation_rate",
            "pauses",
            "pitch",
            "intensity"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "status": {
          "enum": [
            "SCORED",
            "UNSCORABLE"
          ]
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SCORED"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "number"
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
