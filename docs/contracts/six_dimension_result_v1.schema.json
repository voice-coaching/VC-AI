{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voice-coaching:six-dimension-result:v1",
  "title": "Private experimental six dimension assessment and coaching artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assessment",
    "generationStatus",
    "dispatchAttempts",
    "feedback",
    "assessments",
    "model",
    "promptSha256",
    "requestConfigSha256",
    "errorCode",
    "naturalLanguageSemanticsFullyVerified"
  ],
  "properties": {
    "schemaVersion": {
      "const": "voice-coaching.six-dimension-result.v1"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "status",
        "policyRevision",
        "policySha256",
        "validationStatus",
        "association",
        "criteria",
        "selectedCriterionIds",
        "evidence",
        "limitations",
        "dependencies",
        "auxiliary"
      ],
      "properties": {
        "schemaVersion": {
          "const": "voice-coaching.six-dimension-assessment.v1"
        },
        "status": {
          "enum": [
            "READY",
            "PARTIAL",
            "UNSCORABLE"
          ]
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1
        },
        "policySha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "validationStatus": {
          "const": "EXPERT_REVIEW_PENDING"
        },
        "association": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requestId",
            "coreSha256",
            "scriptSha256",
            "sourceAudioSha256",
            "preparedWavSha256"
          ],
          "properties": {
            "requestId": {
              "type": "string",
              "minLength": 1
            },
            "coreSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "scriptSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "sourceAudioSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "preparedWavSha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "criteria": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/criterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "pronunciation_accuracy"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/criterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "speaking_rate"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/criterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "articulation_rate"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/criterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "pauses"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/criterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "pitch"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                {
                  "$ref": "#/$defs/criterion"
                },
                {
                  "properties": {
                    "criterionId": {
                      "const": "intensity"
                    }
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "selectedCriterionIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "maxItems": 3
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evidenceId",
              "criterionId",
              "source",
              "unit",
              "value"
            ],
            "properties": {
              "evidenceId": {
                "type": "string",
                "minLength": 1
              },
              "criterionId": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "unit": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "location": {
                "type": "object"
              },
              "bestAlternative": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "indistinguishablePhones": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "metric": {
                "type": "string"
              },
              "startSeconds": {
                "type": "number",
                "minimum": 0
              },
              "endSeconds": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "criterionIds",
              "reasonCode"
            ],
            "properties": {
              "criterionIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reasonCode": {
                "type": "string"
              }
            }
          }
        },
        "auxiliary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "alignmentAmbiguous",
            "f0Coverage",
            "referenceComparison"
          ],
          "properties": {
            "coverage": {
              "type": [
                "object",
                "null"
              ]
            },
            "alignmentAmbiguous": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "f0Coverage": {
              "type": [
                "number",
                "null"
              ]
            },
            "referenceComparison": {
              "type": [
                "object",
                "null"
              ]
            },
            "composite": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result",
                "worksheet"
              ],
              "properties": {
                "result": {
                  "$ref": "#/$defs/compositeResult"
                },
                "worksheet": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "criterionId",
                      "metric",
                      "referenceN",
                      "weight",
                      "userValue",
                      "mean",
                      "std",
                      "coefficient",
                      "squaredDeviation",
                      "normalizedSquaredDeviation",
                      "unroundedScore",
                      "score"
                    ],
                    "properties": {
                      "criterionId": {
                        "enum": [
                          "speaking_rate",
                          "articulation_rate",
                          "pauses",
                          "pitch",
                          "intensity"
                        ]
                      },
                      "metric": {
                        "enum": [
                          "speech_rate",
                          "articulation_rate",
                          "pause_count_per_10_syllables",
                          "pause_duration_per_10_syllables",
                          "f0_range_st",
                          "intensity_range_db"
                        ]
                      },
                      "referenceN": {
                        "type": "integer",
                        "minimum": 2
                      },
                      "weight": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "userValue": {
                        "type": "number"
                      },
                      "mean": {
                        "type": "number"
                      },
                      "std": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "coefficient": {
                        "type": "number",
                        "exclusiveMinimum": 0
                      },
                      "squaredDeviation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "normalizedSquaredDeviation": {
                        "type": "string",
                        "minLength": 1
                      },
                      "unroundedScore": {
                        "type": "string",
                        "minLength": 1
                      },
                      "score": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "generationStatus": {
      "enum": [
        "NOT_REQUESTED",
        "NOT_DISPATCHED",
        "FAILED",
        "STRUCTURALLY_VALID"
      ]
    },
    "dispatchAttempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "assessments": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "score",
          "evidenceIds",
          "observation"
        ],
        "properties": {
          "criterionId": {
            "type": "string"
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "[가-힣]"
          }
        }
      }
    },
    "feedback": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterionId",
          "evidenceIds",
          "observation",
          "practice"
        ],
        "properties": {
          "criterionId": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "[가-힣]"
          },
          "practice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "pattern": "[가-힣]"
          }
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "promptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestConfigSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "errorCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "naturalLanguageSemanticsFullyVerified": {
      "const": false
    },
    "legacyGrade": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rubricRevision",
            "criteria",
            "overallScore"
          ],
          "properties": {
            "rubricRevision": {
              "const": "phone-rubric-20261003-v1"
            },
            "criteria": {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": false,
              "prefixItems": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "vowels"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "plain_stops"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "tense_stops"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "aspirated_stops"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "fricatives"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "affricates"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "nasals"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "liquid"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterionId",
                    "level"
                  ],
                  "properties": {
                    "criterionId": {
                      "const": "coverage"
                    },
                    "level": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0,
                      "maximum": 4
                    }
                  }
                }
              ]
            },
            "overallScore": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unscorable"
            }
          }
        }
      ]
    },
    "compositeGrade": {
      "$ref": "#/$defs/compositeResult"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generationStatus": {
            "const": "STRUCTURALLY_VALID"
          }
        }
      },
      "then": {
        "properties": {
          "dispatchAttempts": {
            "const": 1
          },
          "assessments": {
            "minItems": 6
          },
          "errorCode": {
            "type": "null"
          }
        },
        "required": [
          "requestSha256"
        ]
      },
      "else": {
        "properties": {
          "feedback": {
            "maxItems": 0
          },
          "assessments": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generationStatus": {
            "enum": [
              "NOT_REQUESTED",
              "NOT_DISPATCHED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "dispatchAttempts": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generationStatus": {
            "const": "FAILED"
          }
        }
      },
      "then": {
        "properties": {
          "dispatchAttempts": {
            "const": 1
          },
          "errorCode": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "requestSha256"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "assessment": {
            "properties": {
              "policyRevision": {
                "const": "announcer-composite-exponential-v2"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "legacyGrade",
          "compositeGrade"
        ],
        "properties": {
          "assessment": {
            "properties": {
              "auxiliary": {
                "required": [
                  "composite"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterionId",
        "label",
        "scope",
        "status",
        "score",
        "reasonCode",
        "evidenceIds",
        "components"
      ],
      "properties": {
        "criterionId": {
          "enum": [
            "pronunciation_accuracy",
            "speaking_rate",
            "articulation_rate",
            "pauses",
            "pitch",
            "intensity"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "SCORED",
            "UNSCORABLE"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "reasonCode": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "value",
              "unit",
              "score",
              "weight",
              "direction"
            ],
            "properties": {
              "metric": {
                "type": "string"
              },
              "value": {
                "type": "number"
              },
              "unit": {
                "type": "string"
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "weight": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "direction": {
                "type": "string"
              },
              "target": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 2
              },
              "validSampleCount": {
                "type": "integer",
                "minimum": 0
              },
              "expectedSampleCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "SCORED"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "evidenceIds": {
                "minItems": 1
              },
              "components": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "compositeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rubricRevision",
        "validationStatus",
        "scoreMeaning",
        "status",
        "overallScore",
        "criteria",
        "missingCriterionIds",
        "selectedCriterionIds",
        "policySha256",
        "referenceSha256"
      ],
      "properties": {
        "rubricRevision": {
          "const": "announcer-composite-exponential-v2"
        },
        "validationStatus": {
          "const": "EXPERT_REVIEW_PENDING"
        },
        "scoreMeaning": {
          "const": "FIXED_PHONE_RUBRIC_AND_PROSODY_REFERENCE_PROXIMITY"
        },
        "status": {
          "enum": [
            "READY",
            "PARTIAL",
            "UNSCORABLE"
          ]
        },
        "overallScore": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "criteria": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": false,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "score",
                "weight"
              ],
              "properties": {
                "criterionId": {
                  "const": "pronunciation_accuracy"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "score",
                "weight"
              ],
              "properties": {
                "criterionId": {
                  "const": "speaking_rate"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "score",
                "weight"
              ],
              "properties": {
                "criterionId": {
                  "const": "articulation_rate"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "score",
                "weight"
              ],
              "properties": {
                "criterionId": {
                  "const": "pauses"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
