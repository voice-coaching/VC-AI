# Downloaded research corpora: never commit or redistribute raw audio/labels.
# Credentials at any depth; only the placeholder template may be committed.
.env
.env.*
!.env.example
/data/raw/
/data/restricted/
/data/cache/
/data/processed/
/data/models/
/data/testvideo/
/artifacts/*
/models/
/checkpoints/

# Local user media, model weights, archives, and generated workspaces.  These
# remain untracked even when they are placed outside the standard data roots.
*.wav
*.flac
*.mp3
*.mp4
*.m4a
*.mov
*.webm
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.tar
*.tar.gz
*.zip
*.b64
*.docx
*.pdf
/build/
/logs/
**/logs/
/vendor/

# Share reviewed guides, the start prompt and the eight developer rules.
# User references, local state and future additions remain ignored.
/.codex/*
!/.codex/README.md
!/.codex/backend-http.md
!/.codex/runpod.md
!/.codex/backblaze.md
!/.codex/env.md
!/.codex/codex_start_prompt.txt
!/.codex/ai_rule_developer/
/.codex/ai_rule_developer/*
!/.codex/ai_rule_developer/GLOBAL_RULES.md
!/.codex/ai_rule_developer/ARCHITECTURE_RULES.md
!/.codex/ai_rule_developer/SERVICE_LAYER_RULES.md
!/.codex/ai_rule_developer/EXTERNAL_INTEGRATION_RULES.md
!/.codex/ai_rule_developer/API_DESIGN_RULES.md
!/.codex/ai_rule_developer/DOMAIN_MODEL_RULES.md
!/.codex/ai_rule_developer/CODE_STYLE_RULES.md
!/.codex/ai_rule_developer/DOCUMENT_RULE.md

# Local architecture working notes remain outside the product clone.
/docs/architecture/

# Local export bundles and detailed evaluation receipts may contain copied
# dependencies, machine paths, or row-level review data.  Publish only a
# sanitized aggregate receipt through artifacts/public/.
/seungun/*bundle*/
/seungun/*.tar.gz.sha256
/seungun/long*_details.txt
/seungun/*nonmatch_review.tsv

# Local Python build/cache artifacts.
.venv*/
__pycache__/
*.py[cod]
*.egg-info/

# Resumable-download state and temporary archives.
*.part
*.aria2

# Single-writer flock files held by publishers at runtime.
*.publish.lock
# Permanent unit/regression tests and synthetic fixtures are excluded by project policy.
tests/
seungun/tests/
scripts/tests/
**/test_*.py
**/*_test.py
**/conftest.py
